      "name": "console_entrypoint",
      "kind": "entrypoint_equals",
      "path": "entrypoint",
      "expected": {
        "metadata_path": "setup.cfg",
        "command": "autore",
        "target": "research_harness.cli:main"
      },
      "weight": 0.15
    },
    {
      "name": "production_components",
