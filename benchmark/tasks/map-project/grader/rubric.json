        {"path": "research_harness/research_agent.py", "symbol": "ResearchAgent"},
        {"path": "research_harness/agent_loop.py", "symbol": "AgentLoop"},
        {"path": "research_harness/agent_state.py", "symbol": "AgentState"},
        {"path": "research_harness/tools/base.py", "symbol": "ToolRegistry"},
        {"path": "research_harness/store.py", "symbol": "ArtifactStore"},
        {"path": "research_harness/validation/final_answer.py", "symbol": "FinalAnswerValidator"}
      ],
      "weight": 0.45
    },
    {
      "name": "runtime_flow",
      "kind": "ordered_contains",
      "path": "runtime_flow",
      "expected": [
        "cli.main",
        "Orchestrator.run",
        "ResearchAgent.with_research_tools",
        "ResearchAgent.arun",
        "AgentLoop.run",
        "FinalAnswerValidator"
