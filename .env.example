# Modal authentication. Set either a token pair or use a profile from ~/.modal.toml.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROFILE=
MODAL_CONFIG_PATH=

# Optional Modal SDK overrides.
MODAL_ENVIRONMENT=
MODAL_SERVER_URL=https://api.modal.com:443
MODAL_LOGLEVEL=

# Optional local executable overrides. Defaults are shown explicitly for consistency.
MAPBENCH_PI=pi
MAPBENCH_DOCKER=docker
PI_CODING_AGENT_DIR=

# The benchmark CLI selects the backend with --backend. Do not set runtime-managed
# MAPBENCH_MODAL_CONFIG, MAPBENCH_MODAL_SANDBOX_ID, or MAPBENCH_MODAL_HELPER values here.
