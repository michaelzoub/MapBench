      "expected": ["expected", "async"],
      "weight": 0.15
    },
    {
      "name": "settled_payment_pending_payout_boundary",
      "kind": "object_fields_contain",
      "path": "settlement_boundary",
      "expected": {
        "payment_status": "SETTLED",
        "payout_status": "PENDING",
        "funds_holder": "MerchantRouter"
      },
      "weight": 0.15
    },
    {
      "name": "payment_state_machine",
