      "weight": 0.1
    },
    {
      "name": "payout_state_machine",
      "kind": "ordered_contains",
      "path": "payout_states",
      "expected": ["PENDING", "CLAIMED", "SUBMITTED", "CONFIRMED"],
      "weight": 0.1
    },
    {
      "name": "two_distinct_onchain_calls",
