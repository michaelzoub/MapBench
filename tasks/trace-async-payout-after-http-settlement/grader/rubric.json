        {
          "contract": "MerchantRouter",
          "function": "executePayout"
        }
      ],
      "weight": 0.15
    },
    {
      "name": "cross_layer_production_path",
      "kind": "object_list_component_contains",
      "path": "production_path",
      "expected": [
        {"path": "examples/express/src/server.ts", "symbol": "marketplace.protect"},
        {"path": "packages/marketplace/src/marketplace.ts", "symbol": "onAfterSettle"},
        {"path": "packages/marketplace/src/settlement.ts", "symbol": "ViemSettlementValidator.validate"},
        {"path": "packages/marketplace/src/store.ts", "symbol": "SqliteMarketplaceStore.confirmPaymentAndEnqueue"},
        {"path": "packages/marketplace/src/worker.ts", "symbol": "PayoutWorker.runOnce"},
        {"path": "packages/marketplace/src/worker.ts", "symbol": "ViemPayoutExecutor.prepare"},
        {"path": "packages/contracts/src/MerchantRouter.sol", "symbol": "MerchantRouter.executePayout"}
      ],
      "weight": 0.25
    },
    {
      "name": "onchain_replay_guards",
      "kind": "list_contains",
      "path": "replay_guards",
